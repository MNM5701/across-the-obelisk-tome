<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tome of Knowledge - Across the Obelisk</title>
    <style>
        body { font-family: sans-serif; background: #1e1e1e; color: #eee; padding: 20px; }
        .controls { display: flex; gap: 15px; margin-bottom: 20px; background: #2d2d2d; padding: 15px; border-radius: 8px; }
        input, select { padding: 8px; border-radius: 4px; border: 1px solid #444; background: #111; color: white; width: 100%; max-width: 400px; }
        
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
        .card-container { background: #2d2d2d; padding: 15px; border-radius: 8px; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        .card-title { margin-top: 0; margin-bottom: 15px; font-size: 1.1em; text-transform: capitalize; color: #ccc; }
        
        .variants { display: flex; gap: 8px; justify-content: center; margin-top: 15px; flex-wrap: wrap; }
        img { max-width: 100%; height: auto; border-radius: 4px; }
        .variant-img { width: 50px; cursor: pointer; transition: transform 0.2s, border 0.2s; border: 2px solid transparent; border-radius: 4px; }
        .variant-img:hover { transform: scale(1.1); }
        .variant-img.active { border: 2px solid #4ade80; }
        .error-state { padding: 40px 10px; background: #333; border-radius: 4px; color: #ff6b6b; font-size: 0.9em; display: flex; align-items: center; justify-content: center; flex-direction: column; min-height: 200px; }
    </style>
</head>
<body>

    <div class="controls">
        <input type="text" id="searchInput" placeholder="Search cards by name or ID..." oninput="filterData()">
        <select id="categoryFilter" onchange="filterData()">
            <option value="all">All Categories</option>
            <option value="normal" selected>Normal Cards</option>
        </select>
        <select id="classFilter" onchange="filterData()">
            <option value="all">All Classes</option>
            <option value="Warrior">Warrior</option>
            <option value="Mage">Mage</option>
            <option value="Healer">Healer</option>
            <option value="Scout">Scout</option>
            <option value="Other">Other</option>
        </select>
        <select id="typeFilter" onchange="filterData()">
            <option value="all">All Types</option>
            <option value="Attack">Attack</option>
            <option value="Defense">Defense</option>
            <option value="Skill">Skill</option>
            <option value="Spell">Spell</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div id="error-message" style="display: none; color: #ff6b6b; background: #333; padding: 20px; border-radius: 8px; text-align: center; margin-bottom: 20px;"></div>

    <div class="grid" id="cardGrid">
        <!-- Cards will be injected here by JavaScript -->
    </div>

    <script>
        let allCards = []; 

        // Basic CSV parser to handle the spreadsheet data
        function parseCSV(text) {
            const results = [];
            let current = [];
            let token = '';
            let inQuotes = false;
            for (let i = 0; i < text.length; i++) {
                const c = text[i];
                if (c === '"') {
                    if (inQuotes && text[i + 1] === '"') { token += '"'; i++; } 
                    else { inQuotes = !inQuotes; }
                } else if (c === ',' && !inQuotes) {
                    current.push(token.trim()); token = '';
                } else if ((c === '\n' || c === '\r') && !inQuotes) {
                    if (c === '\r' && text[i + 1] === '\n') i++;
                    current.push(token.trim()); token = '';
                    if (current.length > 0) { results.push(current); current = []; }
                } else {
                    token += c;
                }
            }
            if (token || current.length > 0) {
                current.push(token.trim()); results.push(current);
            }
            return results;
        }

        // Load the data from cards.json and stats.csv
        async function loadData() {
            try {
                // Fetch JSON
                const response = await fetch('./cards.json'); 
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                const db = await response.json();

                // Fetch CSV
                let statsMap = {};
                try {
                    const csvRes = await fetch('./stats.csv');
                    if (csvRes.ok) {
                        const csvText = await csvRes.text();
                        const rows = parseCSV(csvText);
                        const headers = rows[0].map(h => h.toLowerCase().trim());
                        
                        const nameIdx = headers.indexOf('name') > -1 ? headers.indexOf('name') : 0;
                        const classIdx = headers.indexOf('class');
                        
                        // Map the checkbox columns to card types
                        const typeCols = ['attack', 'defense', 'skill', 'spell'].map(t => ({
                            name: t.charAt(0).toUpperCase() + t.slice(1),
                            idx: headers.findIndex(h => h.includes(t))
                        })).filter(t => t.idx > -1);

                        // Build a lookup dictionary from the CSV
                        for (let i = 1; i < rows.length; i++) {
                            const row = rows[i];
                            if (!row[nameIdx]) continue;
                            
                            const cleanName = row[nameIdx].toLowerCase().trim();
                            let cardType = 'Other';
                            
                            // Find which type checkbox is marked TRUE
                            for (const t of typeCols) {
                                if (row[t.idx] && row[t.idx].toUpperCase() === 'TRUE') {
                                    cardType = t.name;
                                    break;
                                }
                            }

                            statsMap[cleanName] = {
                                heroClass: classIdx > -1 && row[classIdx] ? row[classIdx] : 'Other',
                                cardType: cardType
                            };
                        }
                    }
                } catch(e) {
                    console.log("stats.csv not found or could not be parsed. Proceeding without spreadsheet data.");
                }
                
                const categories = new Set();

                // Parse the JSON into an array, merging with CSV data
                allCards = Object.entries(db.cards).map(([key, data]) => {
                    let category = "normal";
                    let cleanName = key;
                    
                    const match = key.match(/\(([^)]+)\)/);
                    if (match) {
                        category = match[1].toLowerCase();
                        cleanName = key.replace(/\([^)]+\)/g, '').trim();
                    }
                    
                    categories.add(category);
                    
                    // Lookup this card in the spreadsheet map, default to 'Other' if missing
                    const sheetData = statsMap[cleanName.toLowerCase()] || { heroClass: 'Other', cardType: 'Other' };

                    return {
                        idKey: cleanName,
                        category: category,
                        heroClass: sheetData.heroClass,
                        cardType: sheetData.cardType,
                        variants: data.IDs || [], 
                        related: data.RelatedIDs || []
                    };
                });

                // Populate the dropdown with unique categories dynamically
                const categorySelect = document.getElementById('categoryFilter');
                Array.from(categories).filter(c => c !== 'normal').sort().forEach(cat => {
                    const option = document.createElement('option');
                    option.value = cat;
                    option.textContent = cat.charAt(0).toUpperCase() + cat.slice(1);
                    categorySelect.appendChild(option);
                });

                filterData(); 
            } catch (error) {
                console.error("Error loading JSON:", error);
                const errorDiv = document.getElementById('error-message');
                errorDiv.style.display = 'block';
                errorDiv.innerHTML = `<h3>Failed to load cards.json</h3><p>Make sure cards.json is in the same folder as index.html.</p><p style="font-size: 0.8em; color: #aaa;">Technical details: ${error.message}</p>`;
            }
        }

        // Handle missing images gracefully
        function handleImageError(img) {
            if (img.classList.contains('variant-img')) {
                img.style.display = 'none'; // Just hide broken thumbnails
            } else {
                // Show a detailed error box for the main image
                const missingId = img.getAttribute('data-id');
                img.outerHTML = `<div class="error-state" id="${img.id}">Image Not Found<br><small style="margin-top: 10px; color: #aaa;">${missingId}_result.png</small></div>`;
            }
        }

        // Render the UI
        function renderCards(cardsToRender) {
            const grid = document.getElementById('cardGrid');
            grid.innerHTML = ''; 

            cardsToRender.forEach(card => {
                if (card.variants.length === 0) return;

                const baseId = card.variants[0]; 
                const upgrades = card.variants.slice(1); 

                const cardDiv = document.createElement('div');
                cardDiv.className = 'card-container';
                
                let htmlStr = `<h3 class="card-title">${card.idKey}</h3>`;
                
                // Inject the main image - USING card_images/ AND _result.png
                htmlStr += `<img src="./card_images/${baseId}_result.png" id="main-img-${baseId}" alt="${baseId}" data-id="${baseId}" onerror="handleImageError(this)">`;
                
                // Inject upgrade variants
                if (upgrades.length > 0) {
                    htmlStr += `<div class="variants">`;
                    htmlStr += `<img class="variant-img active" id="thumb-${baseId}-${baseId}" src="./card_images/${baseId}_result.png" onclick="swapImage('${baseId}', '${baseId}')" onerror="handleImageError(this)">`;
                    upgrades.forEach(upgradeId => {
                        htmlStr += `<img class="variant-img" id="thumb-${baseId}-${upgradeId}" src="./card_images/${upgradeId}_result.png" onclick="swapImage('${baseId}', '${upgradeId}')" onerror="handleImageError(this)">`;
                    });
                    htmlStr += `</div>`;
                }

                cardDiv.innerHTML = htmlStr;
                grid.appendChild(cardDiv);
            });
        }

        // Handle variant clicking to swap the main image
        function swapImage(baseId, newId) {
            const mainImgElement = document.getElementById(`main-img-${baseId}`);
            
            // If the element is an image, swap its source
            if(mainImgElement.tagName === 'IMG') {
               mainImgElement.src = `./card_images/${newId}_result.png`;
               mainImgElement.setAttribute('data-id', newId);
            } else {
               // If the element is a broken div, recreate the image to try again
               const newImg = document.createElement('img');
               newImg.src = `./card_images/${newId}_result.png`;
               newImg.id = `main-img-${baseId}`;
               newImg.setAttribute('data-id', newId);
               newImg.onerror = function() { handleImageError(this) };
               mainImgElement.parentNode.replaceChild(newImg, mainImgElement);
            }
            
            // Update the green active border on thumbnails
            const variantsContainer = document.getElementById(`thumb-${baseId}-${newId}`).parentElement;
            const thumbs = variantsContainer.querySelectorAll('.variant-img');
            thumbs.forEach(t => t.classList.remove('active'));
            document.getElementById(`thumb-${baseId}-${newId}`).classList.add('active');
        }

        // Simple Search Filter
        function filterData() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const selectedCategory = document.getElementById('categoryFilter').value;
            const selectedClass = document.getElementById('classFilter').value;
            const selectedType = document.getElementById('typeFilter').value;

            const filtered = allCards.filter(card => {
                const matchesSearch = card.idKey.toLowerCase().includes(searchTerm) || 
                                      card.variants.join(' ').toLowerCase().includes(searchTerm);
                const matchesCategory = selectedCategory === 'all' || card.category === selectedCategory;
                const matchesClass = selectedClass === 'all' || card.heroClass === selectedClass;
                const matchesType = selectedType === 'all' || card.cardType === selectedType;

                return matchesSearch && matchesCategory && matchesClass && matchesType;
            });

            renderCards(filtered);
        }

        // Initialize
        loadData();
    </script>
</body>
</html>